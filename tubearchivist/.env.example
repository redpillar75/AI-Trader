# TubeArchivist environment configuration
# Copy to .env and fill in your values

TA_HOST=http://YOUR_SERVER_IP:8000    # your host IP or domain with port
TA_USERNAME=admin                      # initial login username
TA_PASSWORD=changeme                   # initial login password (change this!)
ELASTIC_PASSWORD=changeme              # Elasticsearch password (change this!)
ES_URL=http://archivist-es:9200
REDIS_CON=redis://archivist-redis:6379
HOST_UID=1000                          # your user ID (run: id -u)
HOST_GID=1000                          # your group ID (run: id -g)
TZ=America/New_York                    # your timezone
